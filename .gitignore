# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/

# Environment files (secrets / machine-specific)
.env
.env.*

# Full datasets and generated samples never enter Git
data/raw/
data/processed/
# Generated prepared-sample dataset directories stay untracked; curated small
# files, if ever needed, are added explicitly with `git add -f`.
data/samples/*

# Outputs: artifacts (default output root), checkpoints, TensorBoard runs/cache
artifacts/
checkpoints/
runs/
tensorboard/
*.log

# Local exploratory notebooks (kept out of the public repository)
/notebooks/

# Jupyter
.ipynb_checkpoints/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.hypothesis/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# IDE
/.vscode/

# Local AI tooling configuration (kept out of the public repository)
/.opencode/
