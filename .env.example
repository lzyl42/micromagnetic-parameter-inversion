# Copy to .env (never commit .env) and adjust per machine.
# All values are optional; the code falls back to defaults.

# Path to the MuMax3 executable.
# Defaults: "mumax3" (Linux), "mumax3.exe" (Windows), searched on PATH.
# MUMAX3_BIN=/opt/mumax3/mumax3
# MUMAX3_BIN=C:\mumax3\mumax3.exe

# Override data/output roots.
# Defaults: <project>/data and <project>/artifacts.
# MICROMAG_DATA_ROOT=/mnt/data/micromag
# MICROMAG_OUTPUT_ROOT=/mnt/data/micromag-out
# MICROMAG_DATA_ROOT=D:\micromag\data
# MICROMAG_OUTPUT_ROOT=D:\micromag\out
